# Choose `ollama` for local inference or `openai` for the hosted OpenAI API.
LLM_PROVIDER=ollama

# Ollama runs locally in the Compose stack. `qwen3:8b` is installed locally,
# uses roughly 5.2 GB on disk, and advertises native tool-calling support.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# Optional for local development outside Docker. When QDRANT_URL is omitted,
# ScholarLens stores vectors locally at this path.
# QDRANT_LOCAL_PATH=./data/qdrant
# QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
# QDRANT_API_KEY=replace_with_qdrant_api_key

# Required only when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIM=1536

# DeepEval goldens and LLM-as-a-judge scoring use GPT-5-mini.
# EVAL_MODEL=gpt-5-mini

# Tavily is used only for current web search and claim verification.
TAVILY_API_KEY=replace_with_tavily_key
